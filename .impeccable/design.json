      "css": ":host{--ground:#150b07;--panel:#1f120c;--raise:#2b1911;--line:#40271b;--ink:#fbf1e8;--mute:#cdb5a5;--faint:#a8907f;--accent:#f2762e;--accent-ink:#1a0a02;--accent-2:#5ec1e8;font-family:'Hanken Grotesk',ui-sans-serif,system-ui,sans-serif;font-size:18px;color:var(--ink)}.ds-tools{display:grid;grid-template-columns:repeat(2,6rem);gap:.375rem}.ds-tool{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:.375rem;min-height:4rem;padding:.5rem .25rem;font-weight:400;font-size:.72rem;line-height:1.25;font-family:inherit;border-radius:.5rem;border:1px solid transparent;background:color-mix(in srgb,var(--raise) 60%,transparent);color:var(--mute);cursor:pointer;transition:background .15s,color .15s}.ds-tool:hover{background:var(--raise);color:var(--ink)}.ds-tool[aria-pressed=true]{border-color:var(--accent);background:var(--raise);color:var(--ink)}.ds-tool:focus-visible{outline:2px solid var(--accent);outline-offset:2px}"
